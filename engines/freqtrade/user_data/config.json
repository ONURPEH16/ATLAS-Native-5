{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "ATLAS-NATIVE-FREQTRADE-PAPER",
  "initial_state": "running",
  "dry_run": true,
  "dry_run_wallet": 100,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "max_open_trades": 20,
  "fiat_display_currency": "USD",
  "timeframe": "5m",
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "entry_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "ccxt_config": {"enableRateLimit": true, "options": {"defaultType": "swap"}},
    "ccxt_async_config": {"enableRateLimit": true},
    "pair_whitelist": [".*/USDT:USDT"],
    "pair_blacklist": []
  },
  "pairlists": [
    {"method": "VolumePairList", "number_assets": 100000, "sort_key": "quoteVolume", "min_value": 0, "refresh_period": 1800}
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8081,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "OVERRIDE_WITH_FT_JWT_SECRET_ENV",
    "ws_token": "OVERRIDE_WITH_FT_WS_TOKEN_ENV",
    "username": "native_internal",
    "password": "OVERRIDE_WITH_FT_API_PASSWORD_ENV"
  },
  "force_entry_enable": false,
  "internals": {"process_throttle_secs": 5}
}
